PORT=5001
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# ─── Security ────────────────────────────────────────────────────
# IMPORTANT: Must be changed from default in production!
JWT_SECRET=your_jwt_secret_here
SUPER_ADMIN_EMAIL=admin@your-school-domain.com

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@your-db-host:5432/postgres

# ─── AWS (Production only) ───────────────────────────────────────
# These are injected by AWS Secrets Manager in production.
# For local development, set them here.
AWS_REGION=us-east-1
AWS_S3_BUCKET=wecircle-assets-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_CLOUDFRONT_URL=https://xxxx.cloudfront.net

# ─── Google AI (optional) ────────────────────────────────────────
GOOGLE_AI_API_KEY=your_gemini_api_key
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_IvG7IexJJ
COGNITO_CLIENT_ID=2meppogljnsldj9iivqf6d1p02
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
