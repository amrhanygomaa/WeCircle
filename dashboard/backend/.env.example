PORT=5001
NODE_ENV=development

# ─── Security ────────────────────────────────────────────────────
# Generate a strong random value: openssl rand -base64 48
JWT_SECRET=replace_with_strong_random_secret
SUPER_ADMIN_EMAIL=admin@your-school-domain.com

# ─── CORS origins (comma-separated) ─────────────────────────────
# In production this is the actual frontend URL(s).
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@your-db-host:5432/wecircle

# ─── AWS Cognito ─────────────────────────────────────────────────
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_client_id

# ─── AWS S3 ──────────────────────────────────────────────────────
AWS_S3_BUCKET_NAME=your_s3_bucket_name
# Credentials — use IAM role (ECS task role) in production instead of keys
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── Google AI (optional) ────────────────────────────────────────
GOOGLE_AI_API_KEY=your_gemini_api_key

# ─── Push notifications / FCM (optional) ─────────────────────────
# Firebase service-account key for sending push via FCM. Leave unset to disable
# push (DB + WebSocket notifications still work). See infra/aws/PUSH_NOTIFICATIONS_SETUP.md.
# Provide ONE of: the full key JSON as a single-line string, or a path to the file.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"wecircle",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/wecircle/secrets/firebase-service-account.json
